<Page x:Class="FluentCleaner.Plugins.Tweaks.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FluentCleaner.Plugins.Tweaks"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- progress -->
            <RowDefinition Height="Auto" />
            <!-- outcome of the last run -->
            <RowDefinition Height="Auto" />
            <!-- filters -->
            <RowDefinition Height="Auto" />
            <!-- column headers -->
            <RowDefinition Height="*" />
            <!-- rows -->
            <RowDefinition Height="Auto" />
            <!-- description of the selected rule -->
            <RowDefinition Height="Auto" />
            <!-- actions -->
        </Grid.RowDefinitions>

        <!-- content background from headers to description;filters and footer stay on the panel like in the cleaner -->
        <Border Grid.Row="3" Grid.RowSpan="3"
                Background="{ThemeResource ShellContentBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" />

        <ProgressBar Grid.Row="0"
                     Height="2"
                     Maximum="100"
                     VerticalAlignment="Top"
                     Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay,
                         Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- result of the last run: admin missing, restart needed, failed rules -->
        <InfoBar Grid.Row="1"
                 Margin="10,6,22,0"
                 IsOpen="{x:Bind ViewModel.InfoOpen, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.InfoSeverity, Mode=OneWay}"
                 Title="{x:Bind ViewModel.InfoTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button x:Uid="BtnRestartExplorer"
                        Command="{x:Bind ViewModel.RestartExplorerCommand}"
                        Visibility="{x:Bind ViewModel.NeedsExplorerRestart, Mode=OneWay,
                            Converter={StaticResource BoolToVisibilityConverter}}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- category + "open only" filter -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    Padding="10,8,22,8"
                    VerticalAlignment="Center">
            <ComboBox x:Uid="CmbCategory"
                      MinWidth="180"
                      Height="30"
                      ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CategoryFilter, Mode=TwoWay}" />
            <CheckBox x:Uid="ChkOnlyOpen"
                      MinWidth="0"
                      VerticalAlignment="Center"
                      IsChecked="{x:Bind ViewModel.OnlyOpen, Mode=TwoWay}" />
        </StackPanel>

        <!-- same padding and 28px checkbox column as the rows, so headers line up -->
        <Grid Grid.Row="3" Height="28" Padding="10,0,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1" x:Uid="ColTweak" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" x:Uid="ColCategory" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" x:Uid="ColState" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </Grid>

        <Border Grid.Row="3" VerticalAlignment="Bottom" Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- empty: not scanned yet or nothing matches the filter -->
        <StackPanel Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay,
                        Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon Glyph="&#xE9F5;" FontSize="32"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Uid="TweaksHint"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextAlignment="Center" />
        </StackPanel>

        <!-- selection = detail strip, checkbox = apply;two different things -->
        <ListView Grid.Row="4"
                  ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}"
                  SelectionMode="Single"
                  Padding="0,2,0,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="CornerRadius" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TweakRowViewModel">
                    <!-- RightTapped instead of ContextFlyout (one menu, not one per row).
                         Transparent or the gaps don't get clicks -->
                    <Grid Height="30" Padding="10,0,22,0"
                          Background="Transparent"
                          RightTapped="Row_RightTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>

                        <!-- checkbox without text, else a click on the name ticks it.
                             box = tick, rest of the row = select -->
                        <CheckBox Grid.Column="0"
                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Bind Title}"
                                  MinWidth="0"
                                  Padding="0"
                                  VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="5"
                                    VerticalAlignment="Center">
                            <!-- shield = needs admin (HKLM or policy key) -->
                            <FontIcon Glyph="&#xE72E;" FontSize="11"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind NeedsAdmin,
                                          Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind Title}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind Category}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- state only, apply/reset is in the right-click menu -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="10"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                      Visibility="{x:Bind IsApplied, Mode=OneWay,
                                          Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock x:Uid="TweakStateApplied"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                       Visibility="{x:Bind IsApplied, Mode=OneWay,
                                           Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock x:Uid="TweakStateOpen"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind IsOpen, Mode=OneWay,
                                           Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- detail strip: description + registry values of the selected rule -->
        <Grid Grid.Row="5"
              Padding="10,8,22,8"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay,
                  Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Spacing="3">
                <TextBlock Text="{x:Bind ViewModel.SelectedRow.Description, Mode=OneWay}"
                           FontSize="12"
                           TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.SelectedRow.RegistryPaths, Mode=OneWay}"
                           FontFamily="Cascadia Mono,Consolas"
                           FontSize="11"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- footer, same as CleanerPage: status left, buttons right -->
        <Grid Grid.Row="6"
              Padding="10,6,8,6"
              ColumnSpacing="12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- link to WinRules.ini, looks like "Share selection" in the cleaner -->
            <HyperlinkButton FontSize="11"
                             Padding="0" MinWidth="0" MinHeight="0"
                             VerticalAlignment="Center"
                             Click="Rules_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEA86;" FontSize="14" />
                    <TextBlock Text="WinRules.ini" />
                </StackPanel>
            </HyperlinkButton>

            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Uid="BtnTweaksScan"
                        Command="{x:Bind ViewModel.ScanCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                        MinWidth="96" Height="30" Padding="12,0" />

                <Button x:Uid="BtnTweaksApply"
                        Command="{x:Bind ViewModel.ApplyCommand}"
                        MinWidth="104" Height="30" Padding="12,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
