<Window
    x:Class="FluentCleaner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Title="FluentCleaner">

    <!-- Backdrop is set in App.ApplyBackdrop. Two rows like Terminal: tabs, then the page. -->
    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- F5 refreshes the page in front, if it can. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Plain Grid instead of the TitleBar control, which gave the tab strip no real width.
             48 px: the caption buttons take the top 32, the tabs sit below them. -->
        <Grid Grid.Row="0" Height="48">
            <TabView x:Name="Tabs"
                     VerticalAlignment="Bottom"
                     Background="Transparent"
                     IsAddTabButtonVisible="False"
                     CanReorderTabs="True"
                     CanDragTabs="False"
                     TabWidthMode="SizeToContent"
                     SelectionChanged="Tabs_SelectionChanged"
                     TabCloseRequested="Tabs_TabCloseRequested">
                <!-- selected tab same color as PageHost -->
                <TabView.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="TabViewItemHeaderBackgroundSelected"
                                                ResourceKey="ShellPanelBrush" />
                                <StaticResource x:Key="TabViewBackground"
                                                ResourceKey="ControlFillColorTransparentBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <StaticResource x:Key="TabViewItemHeaderBackgroundSelected"
                                                ResourceKey="ShellPanelBrush" />
                                <StaticResource x:Key="TabViewBackground"
                                                ResourceKey="ControlFillColorTransparentBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <StaticResource x:Key="TabViewItemHeaderBackgroundSelected"
                                                ResourceKey="ShellPanelBrush" />
                                <StaticResource x:Key="TabViewBackground"
                                                ResourceKey="ControlFillColorTransparentBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </TabView.Resources>

                <!-- App menu at the far left, like Edge's tab menu. -->
                <TabView.TabStripHeader>
                    <Button x:Name="AppMenuButton"
                            x:Uid="BtnAppMenu"
                            Width="32"
                            Height="28"
                            Padding="0"
                            Margin="8,0,6,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            Style="{StaticResource SubtleButtonStyle}">
                        <!-- Accent chevron while a filter is active. -->
                        <Grid>
                            <FontIcon x:Name="MenuGlyph" Glyph="&#xE70D;" FontSize="12" />
                            <FontIcon x:Name="MenuGlyphActive" Glyph="&#xE70D;" FontSize="12"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Visibility="Collapsed" />
                        </Grid>
                        <!-- Search box, opened by Ctrl+F or the menu item. -->
                        <primitives:FlyoutBase.AttachedFlyout>
                            <Flyout Placement="BottomEdgeAlignedLeft"
                                    Opened="SearchFlyout_Opened">
                                <AutoSuggestBox x:Name="SearchBox"
                                                x:Uid="SearchBox"
                                                Width="280"
                                                QueryIcon="Find"
                                                TextChanged="SearchBox_TextChanged" />
                            </Flyout>
                        </primitives:FlyoutBase.AttachedFlyout>
                        <Button.Flyout>
                            <!-- Page actions are inserted above the separator on every open. -->
                            <MenuFlyout x:Name="AppMenu"
                                        Placement="BottomEdgeAlignedLeft"
                                        Opening="AppMenu_Opening">
                                <MenuFlyoutSeparator x:Name="AppMenuSeparator" />
                                <!-- Text set in code from SearchBox's placeholder. -->
                                <MenuFlyoutItem x:Name="AppMenuSearch" Click="Search_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE721;" />
                                    </MenuFlyoutItem.Icon>
                                    <MenuFlyoutItem.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control" Key="F" />
                                    </MenuFlyoutItem.KeyboardAccelerators>
                                </MenuFlyoutItem>                                <MenuFlyoutItem x:Uid="AppMenuSettings" Click="Settings_Click" FontWeight="Bold">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <!-- Red heart in Windows' own red, which adapts to light and dark. -->
                                <MenuFlyoutItem x:Uid="AppMenuDonate" Click="Donate_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEB51;"
                                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <!-- "GitHub" in every language, star in accent color -->
                                <MenuFlyoutItem Text="GitHub" Click="GitHub_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE734;"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="AppMenuUpdates" Click="CheckUpdates_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE895;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </TabView.TabStripHeader>

                <TabView.TabStripFooter>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Bottom-aligned with a hand-set lift: centred, it sat above the tabs. -->
                        <Button Grid.Column="0"
                                x:Uid="BtnNewTab"
                                Width="32"
                                Height="24"
                                Padding="0"
                                Margin="4,0,0,5"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                Style="{StaticResource SubtleButtonStyle}">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="NewTabFlyout"
                                            Placement="BottomEdgeAlignedLeft"
                                            Opening="NewTabFlyout_Opening" />
                            </Button.Flyout>
                        </Button>

                        <!-- Drag area, kept even with many tabs open. -->
                        <Border x:Name="TitleDragRegion"
                                Grid.Column="1"
                                MinWidth="48"
                                Background="Transparent" />

                        <TextBlock x:Name="InsiderLabel"
                                   Grid.Column="2"
                                   Margin="8,0,8,10"
                                   FontSize="11"
                                   VerticalAlignment="Bottom"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <!-- Room for the caption buttons, width set in UpdateCaptionInset. -->
                        <Border x:Name="CaptionSpacer" Grid.Column="3" />
                    </Grid>
                </TabView.TabStripFooter>
            </TabView>
        </Grid>

        <!-- Shows the selected tab's Frame on the panel surface (Regedit-style). -->
        <Border x:Name="PageHost"
                Grid.Row="1"
                Background="{ThemeResource ShellPanelBrush}" />

    </Grid>
</Window>
