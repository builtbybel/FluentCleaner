<Window
    x:Class="FluentCleaner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluentCleaner">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="AccelFocusSearch_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native Windows 11 TitleBar: icon + title left, contextual search center, [...] page actions right -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="FluentCleaner"
                  Subtitle="{x:Bind InsiderSubtitle}"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>

            <TitleBar.Content>
                <Grid>
                    <AutoSuggestBox x:Name="TitleSearchBox"
                        x:Uid="SearchBox"
                        MinWidth="180"
                        MaxWidth="340"
                        Width="320"
                        VerticalAlignment="Center"
                        PlaceholderText="Search rules, apps, or paths… (Ctrl+F)"
                        QueryIcon="Find"
                        TextChanged="TitleSearchBox_TextChanged" />

                    <Button x:Name="SearchIconButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Visibility="Collapsed"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.Name="Search"
                        ToolTipService.ToolTip="Search (Ctrl+F)">
                        <FontIcon Glyph="&#xE721;" FontSize="15" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <AutoSuggestBox Width="280"
                                    PlaceholderText="Search rules, apps, or paths…"
                                    QueryIcon="Find"
                                    TextChanged="TitleSearchBox_TextChanged" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </TitleBar.Content>

            <TitleBar.RightHeader>
                <Button x:Name="BtnPageActions"
                        AutomationProperties.Name="Page actions"
                        ToolTipService.ToolTip="More actions"
                        Width="32" Height="32" Padding="0">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground"            Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18808080" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed"     Color="#30808080" />
                        <SolidColorBrush x:Key="ButtonBorderBrush"           Color="Transparent" />
                    </Button.Resources>
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="PageActionsFlyout"
                                    Placement="BottomEdgeAlignedRight"
                                    Opening="PageActionsFlyout_Opening" />
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- Adaptive, grouped WinUI 3 NavigationView -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        IsTitleBarAutoPaddingEnabled="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        CompactPaneLength="48"
                        OpenPaneLength="232"
                        SelectionChanged="NavView_SelectionChanged"
                        ItemInvoked="NavView_ItemInvoked">

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="CORE" />

                <NavigationViewItem x:Name="NavItemCleaner" x:Uid="NavCleaner" Content="Cleaner" Tag="Cleaner"
                                    ToolTipService.ToolTip="Cleaner (Ctrl+1)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA99;" Foreground="#38BDF8" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavItemApps" x:Uid="NavApps" Content="Apps" Tag="Apps"
                                    ToolTipService.ToolTip="Apps Uninstaller (Ctrl+2)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xECAA;" Foreground="#8B5CF6" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavItemTweaks" x:Uid="NavTweaks" Content="Tweaks" Tag="Tweaks"
                                    ToolTipService.ToolTip="Windows Tweaks (Ctrl+3)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9E9;" Foreground="#F97316" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="POWER TOOLS" />

                <NavigationViewItem x:Name="NavItemCustom" x:Uid="NavCustom" Content="Custom" Tag="Custom"
                                    ToolTipService.ToolTip="Custom &amp; Rules (Ctrl+4)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;" Foreground="#10B981" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavItemTerminal" x:Uid="NavTerminal" Content="Terminal" Tag="Terminal"
                                    ToolTipService.ToolTip="Terminal CLI (Ctrl+5)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" Foreground="#06B6D4" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="PROTECTION" />

                <NavigationViewItem Content="Cookies" Tag="Settings:Cookies">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" Foreground="#EAB308" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Exclusions" Tag="Settings:Exclusions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" Foreground="#F43F5E" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Scheduler" Tag="Settings:Scheduler">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" Foreground="#6366F1" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="GitHub"
                                    Content="{x:Bind VersionFooterText}"
                                    SelectsOnInvoked="False"
                                    ToolTipService.ToolTip="Open FluentCleaner on GitHub">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" Foreground="#0078D4" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
