<ContentDialog
    x:Class="FluentCleaner.Views.NewCleanerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="Save_Click">

    <StackPanel Spacing="4">

        <!-- Name -->
        <TextBox x:Name="nameBox" Margin="0,0,0,4" TextChanged="Input_Changed" />

        <!-- AI generate row (hidden when no API key is configured) -->
        <Grid x:Name="aiRow" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="promptBox"
                     Margin="0,0,6,0" />
            <Button x:Name="generateBtn" x:Uid="DlgNewCleanerGenerate" Grid.Column="1" Click="GenerateBtn_Click" />
        </Grid>

        <!-- Content header: label left, Load template right -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="contentLabel" VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <!-- Testing happens after saving: right-click the card, "Test in Rule Lab".
                 Rule Lab opens as a tab, and a tab can't show above this dialog. -->
            <HyperlinkButton Grid.Column="1" x:Uid="DlgNewCleanerLoadTemplate"
                             Padding="0" Click="TemplateBtn_Click" />
        </Grid>

        <!-- Content editor -->
        <TextBox x:Name="contentBox"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="12"
                 Height="260"
                 IsSpellCheckEnabled="False"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 TextChanged="Input_Changed" />

        <!-- Why Save didn't close the dialog: name taken, invalid, or the file couldn't be written -->
        <TextBlock x:Name="errorText" Visibility="Collapsed" TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

    </StackPanel>
</ContentDialog>
