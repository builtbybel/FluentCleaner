<Page
    x:Class="FluentCleaner.Views.CleanerPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FluentCleaner.ViewModels"
    xmlns:ctrl="using:FluentCleaner.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <Grid RowSpacing="0">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="AccelAnalyze_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="AccelClean_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="AccelEscape_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Collapsible Hero Summary & Quick Actions -->
            <RowDefinition Height="Auto" />
            <!-- Actionable Feedback InfoBar (Clean outcome / Undo Exclusion) -->
            <RowDefinition Height="*" />
            <!-- Resizable Two-Pane Workspace -->
            <RowDefinition Height="Auto" />
            <!-- Subtle Status & Telemetry Footer -->
        </Grid.RowDefinitions>

        <!-- =================================================================== -->
        <!-- ROW 0: COLLAPSIBLE HERO SUMMARY & MACRO-CATEGORY TOGGLES            -->
        <!-- =================================================================== -->
        <Border Grid.Row="0"
                Style="{StaticResource DarkSlateCardStyle}"
                Margin="16,12,16,8"
                Padding="16,12">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Compact Header Row (always visible) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Cleaner"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Padding="8,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.SelectedCountSummary, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.LastCleanSummary, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Real System Drive Health Pill -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    Visibility="{x:Bind ViewModel.SystemDriveUsageText, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                            <FontIcon Glyph="&#xEDA2;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.SystemDriveUsageText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ProgressBar Width="110"
                                             Height="3"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{x:Bind ViewModel.SystemDriveUsedPercent, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Compact inline actions when Hero is collapsed -->
                        <Button x:Uid="BtnAnalyze"
                                Command="{x:Bind ViewModel.AnalyzeCommand}"
                                Style="{StaticResource ElectricAccentButtonStyle}"
                                Height="28"
                                Padding="12,0"
                                Visibility="{x:Bind ViewModel.IsHeroExpanded, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <Button Content="{x:Bind ViewModel.CleanButtonLabel, Mode=OneWay}"
                                Click="RunCleaner_Click"
                                IsEnabled="{x:Bind ViewModel.CanRunCleaner, Mode=OneWay}"
                                Style="{StaticResource DarkSecondaryButtonStyle}"
                                Height="28"
                                Padding="12,0"
                                Visibility="{x:Bind ViewModel.IsHeroExpanded, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                        <Button Command="{x:Bind ViewModel.ToggleHeroCommand}"
                                Style="{StaticResource SubtleToolbarButtonStyle}"
                                AutomationProperties.Name="Collapse or expand summary"
                                ToolTipService.ToolTip="Collapse or expand summary">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE70E;"
                                          FontSize="10"
                                          Visibility="{x:Bind ViewModel.IsHeroExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <FontIcon Glyph="&#xE70D;"
                                          FontSize="10"
                                          Visibility="{x:Bind ViewModel.IsHeroExpanded, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Expanded Hero Body: Multi-Segment Vector Donut + 2x2 Macro-Category Cards + Primary Actions -->
                <Grid Grid.Row="1"
                      ColumnSpacing="20"
                      Visibility="{x:Bind ViewModel.IsHeroExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="184" />
                    </Grid.ColumnDefinitions>

                    <!-- Native Multi-Segment Vector Storage Donut Centerpiece -->
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="6">
                        <Grid Width="124" Height="124" HorizontalAlignment="Center">
                            <Canvas x:Name="DonutCanvas" Width="124" Height="124" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.HeroSizeDisplay, Mode=OneWay}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Reclaimable"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.HeroSubtitle, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 2x2 Macro-Category Toggle Cards (Spacious, Zero-Truncation Layout) -->
                    <ItemsRepeater Grid.Column="1"
                                   ItemsSource="{x:Bind ViewModel.MacroCategories, Mode=OneWay}"
                                   VerticalAlignment="Center">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="240"
                                               MaximumRowsOrColumns="2"
                                               MinItemHeight="64"
                                               MinColumnSpacing="12"
                                               MinRowSpacing="10"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:MacroCategoryCardViewModel">
                                <Border Style="{StaticResource SubtleCardStyle}" Padding="14,10">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 36x36 Soft Tint Category Container -->
                                            <Border Grid.Column="0"
                                                    Width="36" Height="36"
                                                    CornerRadius="8"
                                                    Background="{x:Bind BackgroundHex, Converter={StaticResource HexToBrushConverter}}"
                                                    VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind IconGlyph}"
                                                          FontSize="18"
                                                          Foreground="{x:Bind AccentHex, Converter={StaticResource HexToBrushConverter}}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind SizeText, Mode=OneWay}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{x:Bind AccentHex, Converter={StaticResource HexToBrushConverter}}" />
                                                    <TextBlock Text="{x:Bind CountSummary, Mode=OneWay}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <ToggleSwitch Grid.Column="2"
                                                          IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                          AutomationProperties.Name="{x:Bind Title}"
                                                          OnContent=""
                                                          OffContent=""
                                                          MinWidth="0"
                                                          Padding="0"
                                                          VerticalAlignment="Center" />
                                        </Grid>

                                        <ProgressBar Grid.Row="1"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{x:Bind SharePercent, Mode=OneWay}"
                                                     Foreground="{x:Bind AccentHex, Converter={StaticResource HexToBrushConverter}}"
                                                     Height="3" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Stacked Primary Action Cluster -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <Button x:Uid="BtnAnalyze"
                                Command="{x:Bind ViewModel.AnalyzeCommand}"
                                Style="{StaticResource ElectricAccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTipService.ToolTip="Scan selected rules (F5)"
                                HorizontalAlignment="Stretch"
                                Height="36" />

                        <Button x:Uid="BtnCancel"
                                Command="{x:Bind ViewModel.CancelCommand}"
                                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTipService.ToolTip="Cancel active operation (Esc)"
                                HorizontalAlignment="Stretch"
                                Height="36" />

                        <Button Content="{x:Bind ViewModel.CleanButtonLabel, Mode=OneWay}"
                                Click="RunCleaner_Click"
                                IsEnabled="{x:Bind ViewModel.CanRunCleaner, Mode=OneWay}"
                                Style="{StaticResource DarkSecondaryButtonStyle}"
                                ToolTipService.ToolTip="Clean selected items (Ctrl+Shift+C)"
                                HorizontalAlignment="Stretch"
                                Height="34" />

                        <Button Command="{x:Bind ViewModel.SelectDefaultsCommand}"
                                Style="{StaticResource DarkSecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="30"
                                ToolTipService.ToolTip="Reset cleaner selection to recommended defaults">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE734;" FontSize="12" />
                                <TextBlock Text="Select Defaults" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- =================================================================== -->
        <!-- ROW 1: DISMISSIBLE OUTCOME / UNDO EXCLUSION INFOBAR                 -->
        <!-- =================================================================== -->
        <InfoBar Grid.Row="1"
                 Margin="16,0,16,6"
                 IsOpen="{x:Bind ViewModel.BannerOpen, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.BannerSeverity, Mode=OneWay}"
                 Title="{x:Bind ViewModel.BannerTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.BannerMessage, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Content="Undo"
                        Command="{x:Bind ViewModel.UndoLastExclusionCommand}"
                        Visibility="{x:Bind ViewModel.CanUndoExclusion, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- =================================================================== -->
        <!-- ROW 2: RESIZABLE TWO-PANE WORKSPACE                                 -->
        <!-- =================================================================== -->
        <Grid Grid.Row="2" Margin="16,2,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneColumn" Width="360" MinWidth="240" MaxWidth="650" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: CATEGORIES & RULES TREE -->
            <Border Grid.Column="0" Style="{StaticResource DarkSlateCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Left Pane Header -->
                    <Grid Grid.Row="0" Padding="14,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Categories &amp; Rules"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="#F8FAFC"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <Button Command="{x:Bind ViewModel.SelectDefaultsCommand}"
                                    Style="{StaticResource SubtleToolbarButtonStyle}"
                                    AutomationProperties.Name="Restore default selections"
                                    Padding="6,4"
                                    ToolTipService.ToolTip="Restore default selections">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.ExpandAllCommand}"
                                    Style="{StaticResource SubtleToolbarButtonStyle}"
                                    AutomationProperties.Name="Expand all categories"
                                    Padding="6,4"
                                    ToolTipService.ToolTip="Expand all categories">
                                <FontIcon Glyph="&#xE740;" FontSize="12" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.CollapseAllCommand}"
                                    Style="{StaticResource SubtleToolbarButtonStyle}"
                                    AutomationProperties.Name="Collapse all categories"
                                    Padding="6,4"
                                    ToolTipService.ToolTip="Collapse all categories">
                                <FontIcon Glyph="&#xE73F;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Inline Filter Pills -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                Padding="12,0,12,8">
                        <ToggleButton Content="All"
                                      Tag="All"
                                      IsChecked="{x:Bind ViewModel.IsFilterAll, Mode=OneWay}"
                                      Click="FilterPill_Click"
                                      Style="{StaticResource FilterPillStyle}" />
                        <ToggleButton Content="Selected"
                                      Tag="Selected"
                                      IsChecked="{x:Bind ViewModel.IsFilterSelected, Mode=OneWay}"
                                      Click="FilterPill_Click"
                                      Style="{StaticResource FilterPillStyle}" />
                        <ToggleButton Content="Has Size"
                                      Tag="HasSize"
                                      IsChecked="{x:Bind ViewModel.IsFilterHasSize, Mode=OneWay}"
                                      Click="FilterPill_Click"
                                      Style="{StaticResource FilterPillStyle}" />
                        <ToggleButton Content="In Use"
                                      Tag="InUse"
                                      IsChecked="{x:Bind ViewModel.IsFilterInUse, Mode=OneWay}"
                                      Click="FilterPill_Click"
                                      Style="{StaticResource FilterPillStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            VerticalAlignment="Bottom"
                            Height="1"
                            Background="#1E293B" />

                    <!-- Empty state -->
                    <StackPanel Grid.Row="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Padding="24"
                                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE8A5;" FontSize="32"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Uid="CleanerHint"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <!-- Category Expander Tree with 3-State Category CheckBox -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,6,0,8"
                                  Visibility="{x:Bind ViewModel.IsNotEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" Padding="0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CleanerCategoryViewModel">
                                    <Expander HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                              Margin="8,2,8,2"
                                              Padding="0"
                                              CornerRadius="6">
                                        <Expander.Resources>
                                            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#162032" />
                                            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#1E293B" />
                                            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#0F172A" />
                                            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#1E293B" />
                                            <SolidColorBrush x:Key="ExpanderContentBackground" Color="#0D131F" />
                                            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#1E293B" />
                                        </Expander.Resources>
                                        <Expander.Header>
                                            <Grid HorizontalAlignment="Stretch" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsThreeState="True"
                                                          IsChecked="{x:Bind IsCategoryChecked, Mode=TwoWay}"
                                                          AutomationProperties.Name="{x:Bind Name}"
                                                          MinWidth="0"
                                                          Padding="0"
                                                          VerticalAlignment="Center" />

                                                <!-- 28x28 Vibrant Container for Category Icon -->
                                                <Border Grid.Column="1"
                                                        Width="28" Height="28"
                                                        CornerRadius="6"
                                                        Background="{x:Bind IconBackgroundHex, Converter={StaticResource HexToBrushConverter}}"
                                                        Margin="4,0,6,0"
                                                        VerticalAlignment="Center">
                                                    <FontIcon Glyph="{x:Bind IconGlyph}"
                                                              FontSize="14"
                                                              Foreground="{x:Bind AccentColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </Border>

                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F8FAFC"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Name}"
                                                           VerticalAlignment="Center" />

                                                <Border Grid.Column="3"
                                                        Background="#1E293B"
                                                        BorderBrush="#334155"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind HeaderBadgeText, Mode=OneWay}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{x:Bind AccentColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <Button Grid.Column="4"
                                                        AutomationProperties.Name="Category actions"
                                                        ToolTipService.ToolTip="Category actions"
                                                        Width="24" Height="24" Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0">
                                                    <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="#94A3B8" />
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="Bottom">
                                                            <MenuFlyoutItem x:Uid="MenuSelectAll" Command="{x:Bind SelectAllCommand}" />
                                                            <MenuFlyoutItem x:Uid="MenuSelectNone" Command="{x:Bind SelectNoneCommand}" />
                                                            <MenuFlyoutItem x:Uid="MenuSelectDefaults" Command="{x:Bind SelectDefaultsCommand}" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Analyze Category" Tag="{x:Bind}" Click="CatAnalyze_Click" />
                                                            <MenuFlyoutItem Text="Clean Category" Tag="{x:Bind}" Click="CatClean_Click" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{x:Bind Entries, Mode=OneWay}" Padding="4,2,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CleanerEntryViewModel">
                                                    <Grid Padding="4,2" Margin="14,0,4,0"
                                                          PointerEntered="EntryRow_PointerEntered"
                                                          PointerExited="EntryRow_PointerExited">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0"
                                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                  ToolTipService.ToolTip="{x:Bind Warning}"
                                                                  MinWidth="0"
                                                                  Padding="6,3">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <FontIcon Glyph="&#xE7BA;"
                                                                          FontSize="11"
                                                                          Foreground="OrangeRed"
                                                                          VerticalAlignment="Center"
                                                                          Visibility="{x:Bind HasWarning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <TextBlock Text="{x:Bind Name}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTipService.ToolTip="{x:Bind Name}" />
                                                                <Border Visibility="{x:Bind IsProcessRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Background="#22FFB900"
                                                                        BorderBrush="#CCFFB900"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4"
                                                                        Padding="5,1"
                                                                        Margin="2,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        ToolTipService.ToolTip="{x:Bind RunningWarningText, Mode=OneWay}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                                        <FontIcon Glyph="&#xE7BA;" FontSize="9" Foreground="#FFFFB900" VerticalAlignment="Center" />
                                                                        <TextBlock Text="In Use" FontSize="10" Foreground="#FFFFB900" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </CheckBox>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{x:Bind SizeText, Mode=OneWay}"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0,6,0" />

                                                        <Button Grid.Column="2"
                                                                AutomationProperties.Name="Entry actions"
                                                                ToolTipService.ToolTip="Entry actions"
                                                                Width="24" Height="24" Padding="0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Opacity="0.35">
                                                            <FontIcon Glyph="&#xE712;" FontSize="11" />
                                                            <Button.Flyout>
                                                                <MenuFlyout Placement="Bottom">
                                                                    <MenuFlyoutItem Text="Analyze Entry" Tag="{x:Bind}" Click="EntryAnalyze_Click" />
                                                                    <MenuFlyoutItem Text="Clean Entry" Tag="{x:Bind}" Click="EntryClean_Click" />
                                                                    <MenuFlyoutSeparator />
                                                                    <MenuFlyoutItem x:Uid="MenuExplainEntry" Tag="{x:Bind}" Click="EntryExplain_Click" />
                                                                    <MenuFlyoutItem x:Uid="MenuShowSource" Tag="{x:Bind}" Click="EntrySource_Click" />
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- INTERACTIVE RESIZABLE SPLITTER (§8.2) -->
            <Grid Grid.Column="1"
                  x:Name="PaneSplitter"
                  Width="10"
                  Canvas.ZIndex="10"
                  Background="Transparent"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Stretch"
                  PointerEntered="PaneSplitter_PointerEntered"
                  PointerExited="PaneSplitter_PointerExited"
                  PointerPressed="PaneSplitter_PointerPressed"
                  PointerMoved="PaneSplitter_PointerMoved"
                  PointerReleased="PaneSplitter_PointerReleased"
                  PointerCaptureLost="PaneSplitter_PointerCaptureLost">
                <Rectangle x:Name="PaneSplitterLine"
                           Width="2"
                           Height="36"
                           RadiusX="1"
                           RadiusY="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Grid>

            <!-- RIGHT PANE: RESULTS LIST / LIVE ITEM INSPECTOR -->
            <Border Grid.Column="2" Style="{StaticResource DarkSlateCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0"
                                 Maximum="100"
                                 Height="3"
                                 Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- HEADER: RESULTS LIST MODE -->
                    <Grid Grid.Row="1"
                          Padding="14,12,14,10"
                          Visibility="{x:Bind ViewModel.IsShowingDetail, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Scan Results"
                                   Grid.Column="0"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="#F8FAFC"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Margin="0,0,12,0"
                                    Visibility="{x:Bind ViewModel.IsShowingList, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Command="{x:Bind ViewModel.SortResultsDescCommand}"
                                    Style="{StaticResource SubtleToolbarButtonStyle}"
                                    Padding="8,3"
                                    ToolTipService.ToolTip="Sort largest first">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE74B;" FontSize="10" />
                                    <TextBlock Text="Largest" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.SortResultsAscCommand}"
                                    Style="{StaticResource SubtleToolbarButtonStyle}"
                                    Padding="8,3"
                                    ToolTipService.ToolTip="Sort smallest first">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE74A;" FontSize="10" />
                                    <TextBlock Text="Smallest" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Click="ExportReport_Click"
                                    IsEnabled="{x:Bind ViewModel.CanExportReport, Mode=OneWay}"
                                    Style="{StaticResource SubtleToolbarButtonStyle}"
                                    Padding="8,3"
                                    ToolTipService.ToolTip="Export scan audit report (Markdown or CSV)">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xEDE1;" FontSize="11" />
                                    <TextBlock Text="Export Report" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind ViewModel.TotalSize, Mode=OneWay}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- HEADER: LIVE ITEM INSPECTOR MODE -->
                    <Grid Grid.Row="1"
                          Padding="12,10,14,10"
                          Visibility="{x:Bind ViewModel.IsShowingDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{x:Bind ViewModel.ClearDetailCommand}"
                                Style="{StaticResource SubtleToolbarButtonStyle}"
                                AutomationProperties.Name="Back to results"
                                ToolTipService.ToolTip="Back to results (Esc)"
                                Width="30" Height="30" Padding="0">
                            <FontIcon Glyph="&#xE72B;" FontSize="13" />
                        </Button>

                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.SelectedAppName, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedEntrySizeText, Mode=OneWay}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SelectedEntryCountSummary, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Visibility="{x:Bind ViewModel.SelectedEntryIsSafe, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="#2010893E"
                                    BorderBrush="#AA10893E"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#FF2DB85C" VerticalAlignment="Center" />
                                    <TextBlock Text="Safe to Clean" FontSize="11" FontWeight="SemiBold" Foreground="#FF2DB85C" />
                                </StackPanel>
                            </Border>

                            <Border Visibility="{x:Bind ViewModel.SelectedEntryHasWarning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="#22FFB900"
                                    BorderBrush="#CCFFB900"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,3">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="10" Foreground="#FFFFB900" VerticalAlignment="Center" />
                                    <TextBlock Text="Review Warning" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFB900" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            VerticalAlignment="Bottom"
                            Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- BODY A: READY / WELCOME STATE -->
                    <StackPanel Grid.Row="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14"
                                MaxWidth="430"
                                Padding="24"
                                Visibility="{x:Bind ViewModel.IsShowingReady, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Width="56" Height="56"
                                CornerRadius="28"
                                Background="#1A0284C7"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xEA99;" FontSize="24"
                                      Foreground="#38BDF8" />
                        </Border>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Ready to analyze your system"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Toggle categories in the summary bar or tree on the left, then press F5 or click Analyze to inspect every file and registry key before anything is deleted."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Center">
                            <Button x:Uid="BtnAnalyze"
                                    Command="{x:Bind ViewModel.AnalyzeCommand}"
                                    Style="{StaticResource ElectricAccentButtonStyle}"
                                    MinWidth="140"
                                    Height="36" />
                        </StackPanel>
                    </StackPanel>

                    <!-- BODY B: SCAN RESULTS LIST -->
                    <ListView Grid.Row="2"
                              x:Name="ResultsListView"
                              ItemsSource="{x:Bind ViewModel.ResultLines, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="ResultsListView_ItemClick"
                              Padding="4,4"
                              Visibility="{x:Bind ViewModel.IsShowingList, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScanResultLine">
                                <Grid Padding="12,9"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind AppName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind CategoryName, Converter={StaticResource NullToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind CategoryName}"
                                                       FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{x:Bind CountSummary}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,2,0,0" />

                                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{x:Bind Size}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <FontIcon Glyph="&#xE76C;" FontSize="10"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- BODY C: LIVE ITEM INSPECTOR -->
                    <Grid Grid.Row="2"
                          Visibility="{x:Bind ViewModel.IsShowingDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Padding="14,10,14,8">
                            <Button Click="DetailExplain_Click"
                                    Style="{StaticResource SubtleToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE945;" FontSize="12" />
                                    <TextBlock Text="AI Explain" />
                                </StackPanel>
                            </Button>

                            <Button Click="DetailRuleLab_Click"
                                    Style="{StaticResource SubtleToolbarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE943;" FontSize="12" />
                                    <TextBlock Text="Rule Lab" />
                                </StackPanel>
                            </Button>

                            <Button Click="DetailClean_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="12,5"
                                    MinHeight="28">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    <TextBlock Text="Clean Entry" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.ToggleRuleSourceCommand}"
                                    Style="{StaticResource SubtleToolbarButtonStyle}"
                                    ToolTipService.ToolTip="Toggle Winapp2.ini rule excerpt">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="11" />
                                    <TextBlock Text="Rule Source" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="6" Margin="14,0,14,8">
                            <InfoBar IsOpen="{x:Bind ViewModel.SelectedEntryHasWarning, Mode=OneWay}"
                                     IsClosable="False"
                                     Severity="Warning"
                                     Title="Rule Warning"
                                     Message="{x:Bind ViewModel.SelectedEntryWarningText, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.SelectedEntryHasWarning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <InfoBar IsOpen="{x:Bind ViewModel.SelectedEntryIsInUse, Mode=OneWay}"
                                     IsClosable="False"
                                     Severity="Informational"
                                     Title="Application Running"
                                     Message="{x:Bind ViewModel.SelectedEntryInUseText, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.SelectedEntryIsInUse, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <Border Grid.Row="2"
                                Style="{StaticResource SubtleCardStyle}"
                                Margin="14,0,14,8"
                                Padding="12,8"
                                Visibility="{x:Bind ViewModel.IsRuleSourceExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ScrollViewer MaxHeight="110"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock Text="{x:Bind ViewModel.SelectedEntryRawText, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </ScrollViewer>
                        </Border>

                        <ListView Grid.Row="3"
                                  ItemsSource="{x:Bind ViewModel.DetailLines, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="DetailList_ItemClick"
                                  Padding="6,2,6,8">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DetailLine">
                                    <Grid Padding="8,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.ColumnSpan="3"
                                                   Text="{x:Bind Text}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   Margin="0,6,0,2"
                                                   Visibility="{x:Bind IsHeader, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <FontIcon Grid.Column="0"
                                                  Glyph="{x:Bind IconGlyph}"
                                                  FontSize="12"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  VerticalAlignment="Center"
                                                  Visibility="{x:Bind IsNotHeader, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Text}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Text}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{x:Bind IsNotHeader, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem x:Uid="MenuExcludeFile" Click="ExcludeFile_Click" Tag="{x:Bind Text}" />
                                                    <MenuFlyoutItem x:Uid="MenuExcludeFolder" Click="ExcludeFolder_Click" Tag="{x:Bind Text}" />
                                                </MenuFlyout>
                                            </TextBlock.ContextFlyout>
                                        </TextBlock>

                                        <Button Grid.Column="2"
                                                Content="Exclude"
                                                Tag="{x:Bind Text}"
                                                Click="ExcludeFileInline_Click"
                                                Style="{StaticResource InlineActionButtonStyle}"
                                                Visibility="{x:Bind CanExcludeFile, Converter={StaticResource BoolToVisibilityConverter}}"
                                                ToolTipService.ToolTip="Add this file to Global Exclusions" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================== -->
        <!-- ROW 3: SUBTLE FOOTER STATUS & SAFETY TELEMETRY BAR                  -->
        <!-- =================================================================== -->
        <Grid Grid.Row="3" Padding="18,4,18,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.DatabaseBadgeText, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="·" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.ProtectedCookiesText, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="·" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.ExclusionsBadgeText, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="·" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.LifetimeReclaimedText, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>