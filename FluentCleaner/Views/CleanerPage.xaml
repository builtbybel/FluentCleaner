<Page x:Class="FluentCleaner.Views.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FluentCleaner.ViewModels"
    xmlns:local="using:FluentCleaner.Views"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Page.Resources>
        <local:BoolToChevronConverter x:Key="Chevron" />
        <local:PathKindConverter x:Key="PathKind" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- what's new, once after an update -->
            <RowDefinition Height="*" />      <!-- tree | details -->
            <RowDefinition Height="Auto" />   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Closed it takes no room. Opened by ShowWhatsNewOnce. -->
        <InfoBar x:Name="UpdateNotice"
                 Grid.Row="0"
                 Severity="Informational"
                 CornerRadius="0">
            <InfoBar.ActionButton>
                <HyperlinkButton x:Uid="BtnWhatsNew" Click="WhatsNew_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" MaxWidth="460" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Content sheet behind the details; its left border is the divider. -->
            <Border Grid.Column="1" Grid.ColumnSpan="2"
                    Background="{ThemeResource ShellContentBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0" />

            <!-- TREE PANE -->
            <Grid Grid.Column="0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE8A5;" FontSize="32"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Uid="CleanerHint"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextAlignment="Center" />
                </StackPanel>

                <!-- Right padding keeps the [...] buttons clear of the scrollbar. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="10,8,14,4"
                              Visibility="{x:Bind ViewModel.IsNotEmpty, Mode=OneWay,
                                  Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CleanerCategoryViewModel">
                                <StackPanel>

                                    <!-- Category row: click toggles, [...] shows on hover. -->
                                    <Button Style="{StaticResource SubtleButtonStyle}"
                                            Command="{x:Bind ToggleCommand}"
                                            AutomationProperties.Name="{x:Bind DisplayName}"
                                            Padding="0" BorderThickness="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch">
                                        <!-- Right-click, menu key, Shift+F10 or press and hold. On the button,
                                             so the keyboard reaches it when the category has focus. -->
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem x:Uid="MenuSelectAll"
                                                                Command="{x:Bind SelectAllCommand}" />
                                                <MenuFlyoutItem x:Uid="MenuSelectNone"
                                                                Command="{x:Bind SelectNoneCommand}" />
                                                <MenuFlyoutItem x:Uid="MenuSelectDefaults"
                                                                Command="{x:Bind SelectDefaultsCommand}" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="{x:Bind AnalyzeText}"
                                                                Tag="{x:Bind}"
                                                                Click="CatAnalyze_Click" />
                                                <MenuFlyoutItem Text="{x:Bind CleanText}"
                                                                Tag="{x:Bind}"
                                                                Click="CatClean_Click" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <Grid Height="30"
                                              Padding="4,0,2,0"
                                              Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Grid.Column="0"
                                                      Glyph="{x:Bind IsExpanded, Mode=OneWay,
                                                          Converter={StaticResource Chevron}}"
                                                      FontSize="10"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />

                                            <FontIcon Grid.Column="1"
                                                      Glyph="{x:Bind Glyph}" FontSize="14"
                                                      Foreground="{x:Bind IconBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="2,0,8,0" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind DisplayName}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind DisplayName}" />
                                        </Grid>
                                    </Button>

                                    <ItemsControl ItemsSource="{x:Bind Entries, Mode=OneWay}"
                                                  Visibility="{x:Bind IsExpanded, Mode=OneWay,
                                                      Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CleanerEntryViewModel">
                                                <Grid Height="28"
                                                      Padding="4,0,2,0"
                                                      Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- On the row: the checkbox inside takes focus, and the menu key bubbles up to here. -->
                                                    <Grid.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="{x:Bind AnalyzeText}"
                                                                            Tag="{x:Bind}" Click="EntryAnalyze_Click" />
                                                            <MenuFlyoutItem Text="{x:Bind CleanText}"
                                                                            Tag="{x:Bind}" Click="EntryClean_Click" />
                                                            <MenuFlyoutItem x:Uid="MenuExplainEntry"
                                                                            Tag="{x:Bind}" Click="EntryExplain_Click" />
                                                            <MenuFlyoutItem x:Uid="MenuShowSource"
                                                                            Tag="{x:Bind}" Click="EntrySource_Click" />
                                                        </MenuFlyout>
                                                    </Grid.ContextFlyout>

                                                    <!-- Accent bar marks "this will be cleaned". -->
                                                    <Rectangle Grid.Column="0"
                                                               Width="3" Height="16"
                                                               RadiusX="1.5" RadiusY="1.5"
                                                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                               VerticalAlignment="Center"
                                                               Visibility="{x:Bind IsSelected, Mode=OneWay,
                                                                   Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                              AutomationProperties.Name="{x:Bind Name}"
                                                              Checked="EntryCheck_Changed"
                                                              Unchecked="EntryCheck_Changed"
                                                              ToolTipService.ToolTip="{x:Bind Warning}"
                                                              MinWidth="0" MinHeight="0"
                                                              Margin="22,0,0,0"
                                                              Padding="6,0,0,0"
                                                              VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <FontIcon Glyph="&#xE7BA;" FontSize="11"
                                                                      Foreground="#E8903C"
                                                                      VerticalAlignment="Center"
                                                                      Visibility="{x:Bind HasWarning,
                                                                          Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            <TextBlock Text="{x:Bind ShortName}"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTipService.ToolTip="{x:Bind Name}" />
                                                        </StackPanel>
                                                    </CheckBox>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind SizeText, Mode=OneWay}"
                                                               FontFamily="Cascadia Mono,Consolas"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,4,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- DETAILS PANE -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- run header -->
                    <RowDefinition Height="Auto" />   <!-- column headers -->
                    <RowDefinition Height="*" />      <!-- rows -->
                </Grid.RowDefinitions>

                <!-- Run header, like CCleaner's: what is happening or what was found, the size,
                     and the progress while busy. Shows up with the first Analyze. -->
                <StackPanel Grid.Row="0"
                            Padding="10,10,22,10"
                            Spacing="8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Visibility="{x:Bind ViewModel.HasRun, Mode=OneWay,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- always 2 lines high, else the header jumps with every path -->
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                   FontSize="12"
                                   LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                   Height="32"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.TotalSize, Mode=OneWay}"
                                   FontFamily="Cascadia Mono,Consolas"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <!-- Same spot as the size, which is empty after a clean. Only shows when that
                             clean skipped files and the app runs without admin rights. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <HyperlinkButton FontSize="12"
                                             Padding="0" MinWidth="0" MinHeight="0"
                                             Click="UnlockLockedFiles_Click"
                                             Visibility="{x:Bind ViewModel.HasLockedFiles, Mode=OneWay,
                                                 Converter={StaticResource BoolToVisibilityConverter}}"
                                             ToolTipService.ToolTip="Inspect locking processes (File Locksmith) or schedule deletion on reboot">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE785;" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.UnlockFilesLabel, Mode=OneWay}" />
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton FontSize="12"
                                             Padding="0" MinWidth="0" MinHeight="0"
                                             Click="RestartElevated_Click"
                                             Visibility="{x:Bind ViewModel.OfferElevation, Mode=OneWay,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                    <TextBlock x:Uid="BtnRestartElevated" />
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                    </Grid>
                    <!-- Stays after the run (at 100 %, like CCleaner), so the header keeps its height. -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Maximum="100"
                                     Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}"
                                     VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}"
                                   FontFamily="Cascadia Mono,Consolas"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- List headers. Same padding as the rows, so headers and values line up. -->
                <Grid Grid.Row="1"
                      Height="28"
                      Padding="10,0,22,0"
                      Visibility="{x:Bind ViewModel.IsShowingList, Mode=OneWay,
                          Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <!-- Name and Size sort; Contents is only a label. -->
                    <Button Grid.Column="0" Style="{StaticResource SubtleButtonStyle}"
                            Padding="0" CornerRadius="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            VerticalAlignment="Stretch"
                            Click="SortByName_Click">
                        <TextBlock x:Uid="ColName" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                    <TextBlock Grid.Column="1" x:Uid="ColContents" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}"
                            Padding="0" CornerRadius="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"
                            VerticalAlignment="Stretch"
                            Click="SortBySize_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Uid="ColSize" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <FontIcon x:Name="SortGlyph" Glyph="&#xE70D;" FontSize="9"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Detail headers: back, entry name, Type. -->
                <Grid Grid.Row="1"
                      Height="28"
                      Padding="4,0,22,0"
                      Visibility="{x:Bind ViewModel.IsShowingDetail, Mode=OneWay,
                          Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <Button x:Uid="BtnDetailBack"
                            Grid.Column="0"
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="30" Height="26" Padding="0"
                            Command="{x:Bind ViewModel.ClearDetailCommand}">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    </Button>

                    <TextBlock Grid.Column="1"
                               Margin="4,0,8,0"
                               Text="{x:Bind ViewModel.SelectedAppName, Mode=OneWay}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="2" x:Uid="ColType" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                    <!-- Cleans only the open entry. -->
                    <Button x:Uid="BtnCleanDetail"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="30" Height="26" Padding="0"
                            Command="{x:Bind ViewModel.CleanSelectedCommand}">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!-- Results: one line per scanned entry. -->
                <ListView Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.ResultLines, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="ResultsListView_ItemClick"
                          Padding="0,2,0,0"
                          Visibility="{x:Bind ViewModel.IsShowingList, Mode=OneWay,
                              Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScanResultLine">
                            <Grid Height="28" Padding="10,0,22,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>

                                <!-- Grid, not StackPanel, or long names don't trim and run into Contents -->
                                <Grid Grid.Column="0" ColumnSpacing="8" Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="13"
                                              Foreground="{x:Bind IconBrush}"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind AppName}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind AppName}" />
                                    <Border Grid.Column="2"
                                            Background="#22F59E0B"
                                            BorderBrush="#88F59E0B"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind HasLockedFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind LockedLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#FBBF24" />
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind CountSummary}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Size}"
                                           FontFamily="Cascadia Mono,Consolas"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Detail: flat path list. -->
                <ListView Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.DetailLines, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="DetailList_ItemClick"
                          Padding="0,2,0,0"
                          Visibility="{x:Bind ViewModel.IsShowingDetail, Mode=OneWay,
                              Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DetailLine">
                            <Grid Height="26" Padding="10,0,22,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>

                                <!-- Section header ("Files (3988)") -->
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Text}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind IsHeader,
                                               Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Path row -->
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Text}"
                                           FontFamily="Cascadia Mono,Consolas"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind IsNotHeader,
                                               Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Uid="MenuExcludeFile"
                                                            Click="ExcludeFile_Click" Tag="{x:Bind Text}" />
                                            <MenuFlyoutItem x:Uid="MenuExcludeFolder"
                                                            Click="ExcludeFolder_Click" Tag="{x:Bind Text}" />
                                        </MenuFlyout>
                                    </TextBlock.ContextFlyout>
                                </TextBlock>

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Text, Converter={StaticResource PathKind}}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind IsNotHeader,
                                               Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- FOOTER: counts left, actions right. -->
        <Grid Grid.Row="2"
              Padding="10,6,8,6"
              ColumnSpacing="12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- FluentSeed beside the selection it shares. -->
            <Grid Grid.Column="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <HyperlinkButton FontSize="11"
                                 Padding="0" MinWidth="0" MinHeight="0"
                                 VerticalAlignment="Center"
                                 Click="ShareSelection_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72D;" FontSize="14" />
                        <TextBlock x:Uid="ShareSelection" />
                    </StackPanel>
                </HyperlinkButton>
                <TextBlock x:Name="StatusCounts"
                           Grid.Column="1"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Grid>
                    <!-- Padding 12,0: the default cuts off descenders at 30 px. -->
                    <Button x:Uid="BtnAnalyze"
                            Command="{x:Bind ViewModel.AnalyzeCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsNotBusy, Mode=OneWay,
                                Converter={StaticResource BoolToVisibilityConverter}}"
                            MinWidth="96" Height="30" Padding="12,0" />

                    <Button x:Uid="BtnCancel"
                            Command="{x:Bind ViewModel.CancelCommand}"
                            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay,
                                Converter={StaticResource BoolToVisibilityConverter}}"
                            MinWidth="96" Height="30" Padding="12,0" />
                </Grid>

                <Button x:Uid="BtnRunCleaner"
                        Click="RunCleaner_Click"
                        IsEnabled="{x:Bind ViewModel.CanRunCleaner, Mode=OneWay}"
                        MinWidth="104" Height="30" Padding="12,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
