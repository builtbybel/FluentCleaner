<ContentDialog
    x:Class="FluentCleaner.Views.FileLocksmithDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:FluentCleaner.Services"
    Title="Unlock Locked Files (File Locksmith)"
    CloseButtonText="Close"
    DefaultButton="Close">

    <Grid Width="580" MaxHeight="520" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Summary banner -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="DialogSummaryText"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Text="Analyzing file locks via Windows Restart Manager…" />
            <TextBlock Text="Expand any process to inspect or exclude specific locked file paths, close user apps holding locks, or schedule OS-locked files for deletion on your next reboot."
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Loading / feedback strip -->
        <ProgressBar x:Name="LoadingBar"
                     Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="Visible" />

        <InfoBar x:Name="ActionInfoBar"
                 Grid.Row="1"
                 IsOpen="False"
                 IsClosable="True" />

        <!-- Locking processes expandable list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <TextBlock x:Name="EmptyProcessesText"
                           Text="No user applications reported holding direct Restart Manager locks. Remaining files are likely locked by Windows kernel/services or require elevation — use 'Schedule Remaining on Reboot' below."
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <ItemsControl x:Name="ProcessList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:LockingProcessGroup">
                            <Expander HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="0,0,0,6"
                                      Padding="0"
                                      CornerRadius="6">
                                <Expander.Header>
                                    <Grid ColumnSpacing="10" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind AppDisplayName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Background="#22F87171"
                                                        BorderBrush="#88F87171"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind IsSystemProtected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="System Protected" FontSize="10" FontWeight="SemiBold" Foreground="#F87171" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind SummaryText}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="Close &amp; Delete"
                                                Tag="{x:Bind}"
                                                Click="CloseAndDelete_Click"
                                                IsEnabled="{x:Bind CanClose}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Height="28"
                                                Padding="10,0"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Expander.Header>

                                <!-- Expandable locked file paths with inline Exclude -->
                                <ItemsControl ItemsSource="{x:Bind Files}" Padding="10,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="svc:LockedFileItem">
                                            <Grid Padding="4,3" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind FilePath}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind FilePath}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind FormattedSize}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           VerticalAlignment="Center" />

                                                <Button Grid.Column="2"
                                                        Content="Exclude"
                                                        Tag="{x:Bind}"
                                                        Click="ExcludeLockedFile_Click"
                                                        Padding="8,2"
                                                        FontSize="11"
                                                        ToolTipService.ToolTip="Add this file to Global Exclusions" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom bulk actions -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnScheduleReboot"
                    Grid.Column="0"
                    Click="ScheduleReboot_Click"
                    HorizontalAlignment="Left"
                    ToolTipService.ToolTip="Uses MoveFileExW (MOVEFILE_DELAY_UNTIL_REBOOT) to remove OS-locked files on next startup">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE777;" FontSize="12" />
                    <TextBlock Text="Schedule Remaining on Reboot" FontSize="12" />
                </StackPanel>
            </Button>

            <Button x:Name="BtnRetryAll"
                    Grid.Column="1"
                    Click="RetryAll_Click"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    <TextBlock Text="Retry Delete All" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</ContentDialog>
