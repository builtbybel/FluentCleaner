<Page
    x:Class="FluentCleaner.Views.CustomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentCleaner.Views"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Padding="32,26,32,8">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Uid="CustomTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="lblStatus" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- empty state -->
        <StackPanel x:Name="panelEmpty" Grid.Row="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" Opacity="0.45">
            <FontIcon Glyph="&#xE8F4;" FontSize="36" HorizontalAlignment="Center" />
            <TextBlock x:Uid="CustomEmptyHint"
                       FontSize="13" HorizontalAlignment="Center" />
            <TextBlock x:Uid="CustomEmptyHint2"
                       FontSize="12" TextWrapping="WrapWholeWords" TextAlignment="Center"
                       MaxWidth="240" />
        </StackPanel>

        <!-- card grid -->
        <Grid x:Name="panelList" Grid.Row="1" Visibility="Collapsed">
            <ListView x:Name="listCustom" SelectionMode="None" Padding="12,0,12,80">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="220" ItemHeight="160" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment"   Value="Stretch" />
                        <Setter Property="Padding"    Value="0,0,8,8" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:CustomEntryVm">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Opacity="{x:Bind EnabledOpacity, Mode=OneWay}">
                            <Grid Padding="14,10" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: name + ··· menu -->
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{x:Bind Name}"
                                               FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right" Padding="6"
                                            Style="{StaticResource SubtleButtonStyle}">
                                        <FontIcon Glyph="&#xE712;" FontSize="13" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuFlyoutItem x:Uid="MenuEditEntry" Tag="{x:Bind}" Click="Edit_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="MenuTestEntry" Tag="{x:Bind}" Click="TestInLab_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9F5;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="MenuDeleteEntry" Tag="{x:Bind}" Click="Delete_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{x:Bind StatusText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Top" />

                                <ToggleSwitch Grid.Row="2"
                                             IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                             AutomationProperties.Name="{x:Bind Name}"
                                             HorizontalAlignment="Right"
                                             OnContent="" OffContent="" MinWidth="0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Outside the card grid, so it is there when the grid is still empty too. -->
        <Button x:Uid="BtnNewCleaner"
                Grid.Row="1"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Style="{StaticResource AccentButtonStyle}"
                Margin="0,0,32,16"
                Padding="16,8"
                Click="BtnNew_Click" />
    </Grid>
</Page>
