<Page
    x:Class="FluentCleaner.Views.RuleLabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- Opens as a tab, so backdrop, title and theme come from the main window. -->
        <Grid Padding="20,16,20,20" RowSpacing="12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header: Dry Run + spinner + summary -->
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal"
                        Spacing="10" VerticalAlignment="Center">
                <Button x:Name="DryRunButton" Click="DryRun_Click" />
                <ProgressRing x:Name="Ring" Width="18" Height="18" IsActive="False" />
                <TextBlock x:Name="Summary" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- left: editable rules -->
            <TextBox x:Name="SourceBox" Grid.Row="1" Grid.Column="0"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="12"
                     IsSpellCheckEnabled="False"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <!-- right: dry-run log -->
            <TextBox x:Name="ResultsBox" Grid.Row="1" Grid.Column="1"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Consolas" FontSize="11"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />

            <!-- bottom bar: Copy / Report. Closing is the tab's own X. -->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                        Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="CopyButton"   Click="Copy_Click" />
                <Button x:Name="ReportButton" Click="Report_Click" />
            </StackPanel>
        </Grid>
</Page>
