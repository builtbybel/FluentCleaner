<Page
    x:Class="FluentCleaner.Views.TerminalPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- solid background like Windows Terminal (TerminalBrush in App.xaml);transparent was hard to read -->
    <Grid Background="{ThemeResource TerminalBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="OutputScroller"
                      Grid.Row="0"
                      Padding="16,12"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Output}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="13"
                                   TextWrapping="WrapWholeWords"
                                   IsTextSelectionEnabled="True"
                                   Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <AutoSuggestBox x:Uid="TerminalPlaceholder"
                        Grid.Row="1"
                        Margin="12,0,12,12"
                        QueryIcon="Send"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="13"
                        MaxSuggestionListHeight="200"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                        TextChanged="Input_TextChanged"
                        QuerySubmitted="Input_QuerySubmitted" />
    </Grid>
</Page>
