<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Monospace font shared by Rule Preview, TweaksPage, and Terminal -->
    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, Courier New</FontFamily>

    <!-- Column header button style required by AppsPage and TweaksPage -->
    <Style x:Key="ColumnHeaderStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Primary elevated surface card (Fluent 2 Layer/Card) -->
    <Style x:Key="SurfaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Deep obsidian dark slate card (prevents wallpaper muddy brown tint bleed) -->
    <Style x:Key="DarkSlateCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#111827" />
        <Setter Property="BorderBrush" Value="#1E293B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Secondary nested card (for Macro-Category toggles & Inspector panels) -->
    <Style x:Key="SubtleCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#162032" />
        <Setter Property="BorderBrush" Value="#1E293B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Compact pill toggle button for filter bar -->
    <Style x:Key="FilterPillStyle" TargetType="ToggleButton">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#1E293B" />
    </Style>

    <!-- Subtle icon-only or icon+label toolbar button -->
    <Style x:Key="SubtleToolbarButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Compact inline Exclude button on file preview rows -->
    <Style x:Key="InlineActionButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Electric vibrant blue primary button (consistent cyan/blue across all systems) -->
    <Style x:Key="ElectricAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#0284C7" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#38BDF8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Dark slate secondary button -->
    <Style x:Key="DarkSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="Foreground" Value="#F1F5F9" />
        <Setter Property="BorderBrush" Value="#334155" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

</ResourceDictionary>
