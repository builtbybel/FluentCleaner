<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AssemblyName>FCleaner</AssemblyName>
    <RootNamespace>FluentCleaner</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>26.11.123</AssemblyVersion>
    <FileVersion>26.11.123</FileVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <!-- Release is published as native code (NativeAOT): no JIT at start-up, which is most of
       what a WinUI 3 app spends before its first frame. Debug stays on the JIT for F5.
       Anything that needs runtime reflection breaks here first, so test the published exe. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <PropertyGroup>
    <!-- CsWinRT generates its AOT interop for collections as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <!-- The SDK metapackage brings Windows AI and ONNX Runtime along: about 40 MB of
         onnxruntime.dll and DirectML.dll in every release that nothing here ever calls. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.0.185" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.0.300" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.0.300" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Publish leaves out the compiled XAML (.xbf) and the .pri that a build puts next to
       the exe, and an unpackaged app loads both by path. -->
  <Target Name="PublishXamlResources" AfterTargets="ComputeFilesToPublish" DependsOnTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(AllItemsFullPathWithTargetPath)" Condition="'%(AllItemsFullPathWithTargetPath.Extension)' == '.xbf'" RelativePath="%(AllItemsFullPathWithTargetPath.TargetPath)" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" RelativePath="$(ProjectPriFileName)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Shared parsing/cleaning logic lives once in FluentCleaner.Core and is compiled
       in from there as linked source, not a ProjectReference. A reference would clash
       on the Services/Models namespaces this app keeps its own copies of (AppSettings,
       AiExplainer, CleaningService differ by the localized/bound UI bits). -->
  <ItemGroup>
    <Compile Include="..\FluentCleaner.Core\Models\CleanerEntry.cs" Link="Models\CleanerEntry.cs" />
    <Compile Include="..\FluentCleaner.Core\Models\ExcludeKeyEntry.cs" Link="Models\ExcludeKeyEntry.cs" />
    <Compile Include="..\FluentCleaner.Core\Models\FileKeyEntry.cs" Link="Models\FileKeyEntry.cs" />
    <Compile Include="..\FluentCleaner.Core\Models\RegKeyEntry.cs" Link="Models\RegKeyEntry.cs" />
    <Compile Include="..\FluentCleaner.Core\Models\ScanResult.cs" Link="Models\ScanResult.cs" />
    <Compile Include="..\FluentCleaner.Core\Services\CategoryResolver.cs" Link="Services\CategoryResolver.cs" />
    <Compile Include="..\FluentCleaner.Core\Services\CustomEntryService.cs" Link="Services\CustomEntryService.cs" />
    <Compile Include="..\FluentCleaner.Core\Services\DetectionService.cs" Link="Services\DetectionService.cs" />
    <Compile Include="..\FluentCleaner.Core\Services\PathExpander.cs" Link="Services\PathExpander.cs" />
    <Compile Include="..\FluentCleaner.Core\Services\RegistryHelpers.cs" Link="Services\RegistryHelpers.cs" />
    <Compile Include="..\FluentCleaner.Core\Services\Winapp2Parser.cs" Link="Services\Winapp2Parser.cs" />
  </ItemGroup>

  <!-- Localization: every Strings/{lang}/Resources.resw is compiled into the .pri for       -->
  <!-- XAML x:Uid resolution. The glob auto-includes any new language folder on the next      -->
  <!-- build — just drop a Strings/{lang}/Resources.resw and rebuild; no edits needed here.   -->
  <ItemGroup>
    <PRIResource Include="Strings\**\*.resw" />
  </ItemGroup>
  <!-- Also deploy the raw resw folders next to the exe. The strings still come from the .pri; -->
  <!-- these copies exist only so the language dropdown can discover available languages at    -->
  <!-- runtime by scanning Strings\{lang}\ (ResourceService.GetAvailableLanguages).            -->
  <ItemGroup>
    <Content Include="Strings\**\*.resw">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Each plugin's own data files, kept beside its code and deployed to the same relative    -->
  <!-- path. The glob means a rule pack is installed by dropping an .ini into the plugin's     -->
  <!-- folder and uninstalled by deleting it again; no build step knows the file names.        -->
  <ItemGroup>
    <Content Include="Plugins\**\*.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Winapp2.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Ensure PRI resource binary is always deployed to publish output for unpackaged WinUI 3 -->
  <Target Name="CopyPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" Condition="Exists('$(TargetDir)$(TargetName).pri')" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri" DestinationFiles="$(PublishDir)resources.pri" Condition="Exists('$(TargetDir)$(TargetName).pri')" />
  </Target>
</Project>
